{
    "name": "stackealabs/comprobia",
    "description": "Cliente fino de PHP para la API de Comprobia: facturación electrónica SUNAT por API.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://comprobia.stackealabs.com/desarrolladores",
    "keywords": ["sunat", "facturacion electronica", "cpe", "peru", "comprobia"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Comprobia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Comprobia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
